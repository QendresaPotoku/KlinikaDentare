# Copy to .env for local development. In production, set these in the hosting provider's
# environment settings instead of a file. Never commit the real .env. See DEPLOYMENT.md.

# production on the host (strict configuration check: npm start refuses unsafe settings).
# NODE_ENV=production

# PostgreSQL 15+ connection string. The local value matches docker-compose.yml.
# Managed databases usually need SSL: append ?sslmode=require
DATABASE_URL=postgres://klinika:klinika@localhost:54329/klinika

# Separate database used only by `npm test`; its contents are wiped on every run.
# The name must end in "_test" (safety check).
TEST_DATABASE_URL=postgres://klinika:klinika@localhost:54329/klinika_test

# Public address of the site, no path or trailing slash. Production: https://www.your-domain.com.
# Needed at BUILD time too (canonical URLs, trusted proxy domain) and at runtime (email links, cookies).
PUBLIC_SITE_URL=http://localhost:4321

# Node server (npm start). Most hosts set PORT themselves.
HOST=0.0.0.0
PORT=4321

# Secret for the booking-form token and the patients' private cancellation links (min. 32 characters).
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DO NOT rotate it casually in production: every cancellation link already sent would stop working.
APP_SECRET=

# true when the server runs behind a reverse proxy / load balancer (Render, Railway, nginx): the visitor
# IP for rate limiting is then the LAST X-Forwarded-For entry (added by the proxy). false for direct access.
TRUST_PROXY=false
# Number of trusted proxies in front of the app (only for CDN + load balancer chains).
# TRUST_PROXY_HOPS=1

# ---- Email (only the clinic's internal notice about new online bookings; patients get SMS, not email)
# console = only log "would send" lines (development). smtp = really send (production).
EMAIL_PROVIDER=console
# Any SMTP service: the clinic's mail host, Mailgun, Amazon SES, Brevo, Postmark, …
# Port 587 uses STARTTLS (required); port 465 uses TLS from the start (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender of the clinic notice, e.g. "Klinika Dentare Dr. Petriti & Dr. Vlera <termine@your-domain.com>"
EMAIL_FROM=
# Optional: reply-to address of the clinic notice.
EMAIL_REPLY_TO=
# Local test mail servers without TLS only (Mailpit). Refused when NODE_ENV=production.
# SMTP_ALLOW_INSECURE=true

# ---- SMS (patient booking confirmation + reminder about 24 h before the appointment)
# none = no SMS is sent (due messages are marked "SMS not configured" in the admin panel).
# console = only log "would send" lines with a masked number (development).
# No real SMS provider is connected yet: see src/server/notifications/sms.ts. Its credentials
# will go here (e.g. SMS_PROVIDER=infobip, INFOBIP_API_KEY=…, SMS_SENDER=…).
SMS_PROVIDER=none

# Background sending of queued notifications inside the server process (every 60 s and right
# after each change). Set to "off" only if another process sends them.
NOTIFICATIONS_WORKER=on
