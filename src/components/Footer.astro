---
import LogoMark from './LogoMark.astro';
import Icon from './Icon.astro';
import { useT, paths, ph, type Lang } from '../i18n';
import { site, links } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="cols">
      <a class="mark" href={paths.home(lang)} aria-label={site.name}>
        <LogoMark />
      </a>
      <div class="col col--pages">
        <p class="col-title">{t.footer.explore}</p>
        <ul>
          <li><a href={paths.treatments(lang)}>{t.nav.treatments}</a></li>
          <li><a href={paths.team(lang)}>{t.nav.doctors}</a></li>
          <li><a href={paths.gallery(lang)}>{t.nav.gallery}</a></li>
          <li><a href={paths.diaspora(lang)}>{t.nav.diaspora}</a></li>
          <li><a href={paths.section(lang, 'contact')}>{t.nav.contact}</a></li>
        </ul>
      </div>
      <div class="col col--address">
        <p class="col-title">{t.contact.address}</p>
        <address>
          <span set:html={ph(site.address.line1, lang)} /><br />
          {site.address.line2}
        </address>
      </div>
      <div class="col col--contact">
        <p class="col-title">{t.footer.contact}</p>
        <ul>
          <li><a href={links.tel} set:html={ph(site.phone.display, lang)} /></li>
          <li><a class="email" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="channels">
            <a href={links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
            <a href={links.viber}><Icon name="viber" />Viber</a>
          </li>
        </ul>
      </div>
      <div class="col col--hours">
        <p class="col-title">{t.contact.hours}</p>
        <dl class="hours">
          {site.hours.map((h) => (
            <div>
              <dt>{t.contact.days[h.days]}</dt>
              <dd set:html={h.time === 'closed' ? ph(`[[${t.common.closed}]]`, lang) : ph(h.time, lang)} />
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} {site.name}. {t.footer.rights}</p>
      <a href="#top" class="to-top" data-to-top>{t.footer.top} ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgb(250 249 247 / 0.72);
    padding: clamp(56px, 7vw, 104px) 0 calc(28px + var(--mobile-bar, 0px));
    font-size: 0.9375rem;
  }
  /* Logo leads the columns row, aligned with the column titles */
  .mark {
    align-self: start;
    color: var(--crimson);
    width: clamp(56px, 5vw, 80px);
  }
  /* One row: logo, pages, address, contact, hours */
  .cols {
    display: grid;
    grid-template-columns: minmax(56px, 0.7fr) minmax(0, 0.9fr) minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1.3fr);
    column-gap: var(--col-gap);
    row-gap: 40px;
    padding-bottom: clamp(44px, 5vw, 72px);
  }

  .col-title {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(250 249 247 / 0.45);
    margin-bottom: 18px;
  }
  .col ul {
    display: grid;
    gap: 8px;
  }
  .col a {
    transition: color 0.4s var(--ease);
  }
  .col a:hover {
    color: var(--paper);
  }
  address {
    font-style: normal;
  }
  .email {
    overflow-wrap: anywhere;
  }
  .channels {
    display: flex;
    gap: 20px;
    margin-top: 6px;
  }
  .channels a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .channels :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 0;
    border-bottom: 1px solid var(--line-light);
  }
  .hours dd {
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid var(--line-light);
    font-size: 0.8125rem;
    color: rgb(250 249 247 / 0.45);
  }
  .to-top:hover {
    color: var(--paper);
  }

  @media (max-width: 1024px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mark {
      grid-column: 1 / -1;
    }
  }
  /* Phones: logo, then pages beside address, then contact and hours full width */
  @media (max-width: 600px) {
    .footer {
      padding-top: 48px;
    }
    .cols {
      column-gap: 24px;
      row-gap: 32px;
      padding-bottom: 36px;
    }
    .mark {
      width: 44px;
    }
    .col-title {
      margin-bottom: 12px;
    }
    .col--contact,
    .col--hours {
      grid-column: 1 / -1;
    }
    .bottom {
      flex-direction: column;
      gap: 8px;
      padding-top: 20px;
    }
  }
</style>
