---
/**
 * Appointment request popup. Opened by any element with `data-book`.
 * Not connected to a backend yet: submitting only shows the confirmation state.
 */
import Arrow from './Arrow.astro';
import { useT, type Lang } from '../i18n';
import { treatments } from '../data/treatments';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const b = t.booking;
---

<dialog class="booking" aria-labelledby="booking-title" data-booking data-lenis-prevent>
  <div class="panel">
    <button type="button" class="close" data-booking-close aria-label={b.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>

    <form class="form" data-booking-form>
      <header class="head">
        <h2 id="booking-title" class="h3">{b.title}</h2>
        <p class="intro">{b.intro}</p>
      </header>

      <div class="fields">
        <label class="field field--full">
          <span>{b.name}</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="field">
          <span>{b.phone}</span>
          <input type="tel" name="phone" autocomplete="tel" required />
        </label>
        <label class="field">
          <span>{b.email} <em>({b.optional})</em></span>
          <input type="email" name="email" autocomplete="email" />
        </label>
        <label class="field field--full">
          <span>{b.treatment}</span>
          <select name="treatment">
            <option value="">{b.treatmentAny}</option>
            {treatments.map((tr) => (
              <optgroup label={tr.copy[lang].name}>
                <option value={tr.id}>{tr.copy[lang].name}</option>
                {tr.children.map((s) => <option value={`${tr.id}/${s.id}`}>{s.copy[lang].name}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
        <label class="field">
          <span>{b.date}</span>
          <input type="date" name="date" data-booking-date />
        </label>
        <label class="field">
          <span>{b.time}</span>
          <select name="time">
            <option value="any">{b.times.any}</option>
            <option value="morning">{b.times.morning}</option>
            <option value="afternoon">{b.times.afternoon}</option>
          </select>
        </label>
        <label class="field field--full">
          <span>{b.message} <em>({b.optional})</em></span>
          <textarea name="message" rows="3"></textarea>
        </label>
      </div>

      <button type="submit" class="btn btn--primary submit">{b.submit}<Arrow /></button>
    </form>

    <div class="success" data-booking-success hidden>
      <span class="tick" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </span>
      <h2 class="h3">{b.successTitle}</h2>
      <p class="intro">{b.successText}</p>
      <button type="button" class="btn btn--ghost" data-booking-close>{b.done}</button>
    </div>
  </div>
</dialog>

<style>
  .booking {
    width: min(640px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
  }
  .booking:global(.is-open) {
    opacity: 1;
    transform: none;
  }
  .booking::backdrop {
    background: rgb(18 16 16 / 0.6);
    backdrop-filter: blur(3px);
  }
  .panel {
    position: relative;
    padding: clamp(28px, 4vw, 48px);
    border-top: 3px solid var(--crimson);
  }
  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }
  .close svg {
    width: 20px;
    height: 20px;
  }
  .close:hover {
    color: var(--crimson);
  }
  .head {
    display: grid;
    gap: 10px;
    padding-right: 32px;
    margin-bottom: 28px;
  }
  .intro {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 20px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field > span {
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .field em {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
    color: var(--muted-light);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 0;
    transition: border-color 0.3s var(--ease);
  }
  .field textarea {
    resize: vertical;
    min-height: 88px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--crimson);
  }
  .submit {
    margin-top: 28px;
    width: 100%;
    justify-content: center;
  }
  .success {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 24px 0 8px;
    text-align: center;
  }
  /* display: grid above would otherwise override the hidden attribute */
  .form[hidden],
  .success[hidden] {
    display: none;
  }
  .success .btn {
    margin-top: 12px;
  }
  .tick {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--blush);
    color: var(--crimson);
  }
  .tick svg {
    width: 26px;
    height: 26px;
  }

  @media (max-width: 560px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
