---
// Editorial header for secondary pages on a light background.
import Ph from './Ph.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  intro?: string;
  crumbs?: { label: string; href: string }[];
  meta?: string;
  /** Tighter spacing for pages whose content follows straight after the title. */
  compact?: boolean;
  /** Something already clears the fixed site header above (e.g. the treatment bar). */
  flush?: boolean;
}
const { lang, eyebrow, title, intro, crumbs = [], meta, compact = false, flush = false } = Astro.props;
---

<header class:list={['page-header container', { compact, flush }]}>
  {crumbs.length > 0 && (
    <nav class="crumbs" aria-label="Breadcrumb" data-reveal="fade" data-immediate data-delay="0.1">
      <ol>
        {crumbs.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ol>
    </nav>
  )}
  <div class="grid">
    <div class="main">
      <p class="label" data-reveal="fade" data-immediate data-delay="0.2">{eyebrow}</p>
      <h1 class="h1 title" data-split data-immediate data-delay="0.3">{title}</h1>
    </div>
    <div class="side">
      {meta && <p class="index-num" data-reveal="fade" data-immediate data-delay="0.6">{meta}</p>}
      {intro && <Ph as="p" class="lead" text={intro} lang={lang} data-reveal="fade" data-immediate data-delay="0.7" />}
      <slot />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-top: calc(var(--header-h) + clamp(48px, 6.5vw, 112px));
    padding-bottom: clamp(48px, 5vw, 88px);
  }
  .page-header.compact {
    padding-top: calc(var(--header-h) + clamp(32px, 4vw, 64px));
    padding-bottom: clamp(24px, 3vw, 48px);
  }
  .page-header.flush {
    padding-top: clamp(32px, 4vw, 64px);
  }
  .compact .crumbs ol {
    margin-bottom: clamp(20px, 2.5vw, 32px);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--muted);
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    color: var(--muted-light);
  }
  .crumbs a:hover {
    color: var(--crimson);
  }
  .grid {
    align-items: end;
    row-gap: 36px;
  }
  .main {
    grid-column: 1 / span 8;
    display: grid;
    gap: 28px;
  }
  .title {
    max-width: 14em;
  }
  .side {
    grid-column: 9 / span 4;
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-bottom: 0.6em;
  }
  @media (max-width: 900px) {
    .main,
    .side {
      grid-column: 1 / -1;
    }
  }
</style>
