---
import { Image } from 'astro:assets';
import Arrow from '../Arrow.astro';
import { useT, paths, type Lang } from '../../i18n';
import { featuredTreatments } from '../../data/treatments';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="treatments section" id="treatments" aria-labelledby="treatments-title">
  <div class="container">
    <header class="head grid">
      <div class="head-l">
        <p class="label" data-reveal="fade">{t.treatments.label}</p>
        <h2 id="treatments-title" class="h2" data-split>{t.treatments.heading}</h2>
      </div>
      <div class="head-r" data-reveal="fade">
        <a class="link" href={paths.treatments(lang)}>{t.treatments.all}<Arrow /></a>
      </div>
    </header>

    <div class="list-wrap grid" data-treatment-list>
      <div class="preview" aria-hidden="true">
        <div class="preview-frame media" data-reveal="mask">
          {featuredTreatments.map((tr) => (
            <div class="preview-img" data-preview>
              <Image src={tr.image} alt="" widths={[600, 900, 1200]} sizes="36vw" />
            </div>
          ))}
        </div>
      </div>

      <ol class="list">
        {featuredTreatments.map((tr, i) => {
          const c = tr.copy[lang];
          return (
            <li class="row" data-row data-reveal="fade">
              <a href={paths.treatment(lang, c.slug)}>
                <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-main">
                  <span class="row-name">{c.name}</span>
                  <span class="row-sum">{c.summary}</span>
                </span>
                <span class="row-thumb media">
                  <Image src={tr.image} alt="" widths={[200, 400]} sizes="96px" />
                </span>
                <span class="row-go">
                  <span class="visually-hidden">{t.treatments.view}</span>
                  <Arrow />
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .treatments {
    position: relative;
    background: var(--stone);
  }
  .head {
    align-items: end;
    row-gap: 20px;
    margin-bottom: clamp(28px, 3vw, 44px);
  }
  .head-l {
    grid-column: 1 / span 8;
    display: grid;
    gap: 24px;
  }
  /* Link sits flush right, on the same edge as the list below it */
  .head-r {
    grid-column: 9 / -1;
    justify-self: end;
  }

  /* Photo and list share one row, so the photo is exactly as tall as the list */
  .list-wrap {
    align-items: stretch;
  }
  .preview {
    grid-column: 1 / span 6;
  }
  .preview-frame {
    height: 100%;
    min-height: 360px;
  }
  .preview-img {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.1s var(--ease-in-out);
    z-index: 0;
  }
  .preview-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transition: transform 1.6s var(--ease);
  }
  .preview-img:global(.is-active) {
    clip-path: inset(0 0 0 0);
    z-index: 1;
  }
  .preview-img:global(.is-active) :global(img) {
    transform: scale(1);
  }

  .list {
    grid-column: 7 / -1;
    padding-left: clamp(0px, 2.5vw, 40px);
    border-top: 1px solid var(--line);
    counter-reset: t;
  }
  .row {
    border-bottom: 1px solid var(--line);
  }
  .row a {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 20px;
    padding: clamp(18px, 1.7vw, 26px) 0;
  }
  .row-main {
    display: grid;
    gap: 6px;
  }
  .row-name {
    font-size: clamp(1.375rem, 2vw, 2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    transition:
      color 0.5s var(--ease),
      transform 0.8s var(--ease);
  }
  .row-sum {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .row-go {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background-color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      color 0.5s var(--ease);
  }
  .row-go :global(.arrow) {
    width: 18px;
  }
  .row-thumb {
    display: none;
  }
  .row:global(.is-active) .row-name,
  .row a:focus-visible .row-name {
    color: var(--crimson);
    transform: translateX(10px);
  }
  .row:global(.is-active) .row-go {
    background: var(--crimson);
    border-color: var(--crimson);
    color: #fff;
  }

  @media (max-width: 1024px) {
    .head-l {
      grid-column: 1 / -1;
    }
    .head-r {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .preview {
      display: none;
    }
    .list {
      grid-column: 1 / -1;
      padding-left: 0;
    }
    .row:global(.is-active) .row-name {
      color: inherit;
      transform: none;
    }
    .row:global(.is-active) .row-go {
      background: none;
      border-color: var(--line);
      color: inherit;
    }
    .row a {
      grid-template-columns: 40px 1fr 80px;
    }
    .row-thumb {
      display: block;
      width: 80px;
      aspect-ratio: 1;
    }
    .row-go {
      display: none;
    }
  }
  @media (max-width: 600px) {
    /* Number stays inline with the name instead of taking its own line */
    .row a {
      grid-template-columns: 24px 1fr 64px;
      gap: 14px;
      padding: 16px 0;
    }
    .row-thumb {
      width: 64px;
    }
    .row-name {
      font-size: 1.3125rem;
    }
    .row-sum {
      font-size: 0.875rem;
    }
  }
</style>
