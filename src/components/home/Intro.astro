---
import { Image } from 'astro:assets';
import Arrow from '../Arrow.astro';
import Ph from '../Ph.astro';
import { useT, paths, type Lang } from '../../i18n';
import chair from '../../assets/photos/chair-window.jpg';
import instruments from '../../assets/photos/instruments-still.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="intro section" id="clinic" aria-labelledby="intro-title">
  <div class="container">
    <div class="head grid">
      <p class="label" data-reveal="fade">{t.intro.label}</p>
      <h2 id="intro-title" class="statement" data-words>{t.intro.statement}</h2>
    </div>

    <div class="body-grid grid">
      <figure class="img-main media" data-reveal="mask">
        <div data-parallax="7">
          <Image src={chair} alt="" widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 42vw" />
        </div>
      </figure>

      <div class="aside">
        <div class="copy">
          <span class="rule" data-reveal="line" aria-hidden="true"></span>
          <p class="lead" data-reveal="fade">{t.intro.text1}</p>
          <Ph as="p" class="lead" text={t.intro.text2} lang={lang} data-reveal="fade" />
          <a class="link link--crimson" href={paths.team(lang)} data-reveal="fade">
            {t.intro.link}
            <Arrow />
          </a>
        </div>

        <figure class="img-small media" data-reveal="mask">
          <Image src={instruments} alt="" widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 30vw" />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    z-index: 2;
    background: var(--paper);
  }
  .head {
    row-gap: 28px;
    align-items: start;
  }
  .head .label {
    grid-column: 1 / span 3;
    padding-top: 0.9em;
  }
  .head .statement {
    grid-column: 4 / span 9;
    max-width: 22em;
  }

  .body-grid {
    margin-top: clamp(32px, 3.2vw, 48px);
    align-items: stretch;
  }
  /* Main photo fills the row, so its bottom edge lines up with the small photo */
  .img-main {
    grid-column: 1 / span 6;
    min-height: clamp(400px, 36vw, 560px);
  }
  .aside {
    grid-column: 7 / -1;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 2.6vw, 40px);
    padding-left: clamp(0px, 2.5vw, 40px);
  }
  .copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  /* The grid gap already separates paragraphs; drop the global .lead + .lead margin */
  .copy > :global(.lead) {
    margin-top: 0;
  }
  .rule {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--line);
    margin-bottom: 8px;
  }
  .copy .link {
    margin-top: 4px;
  }
  /* Takes whatever height is left, so the column ends flush with the main photo */
  .img-small {
    flex: 1 1 0;
    min-height: 200px;
  }
  .img-small :global(img) {
    position: absolute;
    inset: 0;
    object-position: 50% 22%;
  }

  @media (max-width: 1024px) {
    .head .label {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .head .statement {
      grid-column: 1 / -1;
    }
    .img-main {
      min-height: 420px;
    }
    .aside {
      padding-left: 0;
    }
  }
  @media (max-width: 760px) {
    .body-grid {
      margin-top: 36px;
      row-gap: 0;
    }
    /* Text first on phones: it carries the message, photos follow as a compact pair */
    .aside {
      display: contents;
    }
    .copy {
      grid-column: 1 / -1;
      order: 1;
    }
    .img-main {
      grid-column: 1 / span 7;
      order: 2;
      min-height: 0;
      aspect-ratio: 4 / 5;
      margin-top: 32px;
    }
    .img-small {
      grid-column: 8 / -1;
      order: 3;
      align-self: end;
      min-height: 0;
      aspect-ratio: 3 / 4;
    }
  }
</style>
