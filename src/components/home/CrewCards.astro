---
// Home-page team section: each doctor appears as a staff badge hanging from a lanyard that
// runs up past the top of the section. Pure HTML/CSS; the only motion is the hover swing.
import Arrow from '../Arrow.astro';
import IdCard, { type IdCardPerson } from '../IdCard.astro';
import { useT, paths, type Lang } from '../../i18n';
import { teamGroups } from '../../data/team';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const members = teamGroups.flatMap((g) => g.members);
const crew = members.map((m) => {
  const copy = m.kind === 'doctor' ? t.doctors.people[m.index] : t.team.staff[m.index];
  const [firstName, ...rest] = copy.name.split(' ');
  const person: IdCardPerson = {
    firstName,
    lastName: rest.join(' '),
    role: copy.role,
    tone: m.tone,
    photo: m.photo,
    focus: m.focus,
  };
  return { id: m.id, name: copy.name, tag: t.team.groups[m.kind === 'doctor' ? 'doctors' : 'staff'], person };
});

// Deliberately uneven, so the badges read as hung by hand rather than set on a grid
const drops = ['4.5rem', '9rem', '2.5rem', '6.5rem'];
const dropsMobile = ['3rem', '5.5rem', '2rem', '4rem'];
const tilts = [-3, 2.5, -1.2, 1.8];
const at = <T,>(list: T[], i: number) => list[i % list.length];
---

<section class="crew" id="doctors" aria-labelledby="crew-title">
  <div class="container grid">
    <div class="intro">
      <p class="label" data-reveal="fade">{t.doctors.label}</p>
      <h2 id="crew-title" class="h2" data-split>{t.doctors.heading}</h2>
      <p class="names" data-reveal="fade">{crew.map((c) => c.name).join(' · ')}</p>
      <a class="link link--crimson" href={paths.team(lang)} data-reveal="fade">{t.doctors.cta}<Arrow /></a>
    </div>

    <ul class="badges">
      {crew.map((c, i) => (
        <li style={`--drop:${at(drops, i)};--drop-m:${at(dropsMobile, i)}`}>
          <IdCard
            person={c.person}
            lang={lang}
            href={`${paths.team(lang)}#${c.id}`}
            tilt={at(tilts, i)}
            tag={c.tag}
            cardSizes="(max-width: 899px) 190px, 300px"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .crew {
    position: relative;
    overflow: hidden;
    min-height: clamp(520px, 44vw, 640px);
    background: var(--stone);
    /* The badge slots show the wall behind them */
    --badge-hole: var(--stone);
  }
  .grid {
    align-items: start;
  }

  .intro {
    grid-column: 1 / span 4;
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-block: var(--section);
  }
  .intro .h2 {
    margin-top: 8px;
  }
  .names {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink);
  }
  .intro .link {
    margin-top: 12px;
  }

  .badges {
    grid-column: 5 / -1;
    display: flex;
    justify-content: space-evenly;
    align-items: flex-start;
    /* Just enough room for the card shadow; the next section brings its own top padding */
    padding-bottom: 16px;
  }
  /* The hanging badges already end low in the section, so the next one needs less lead-in */
  .crew + :global(.section) {
    padding-top: var(--section-sm);
  }
  .badges li {
    padding-top: var(--drop);
  }
  .badges :global(.id-card) {
    --w: clamp(230px, 21vw, 300px);
  }

  @media (max-width: 899px) {
    .grid {
      display: block;
    }
    .intro {
      padding-bottom: 0;
    }
    /* Only this row scrolls sideways; it runs edge to edge, past the page gutter */
    .badges {
      justify-content: safe center;
      gap: 1.5rem;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .badges::-webkit-scrollbar {
      display: none;
    }
    .badges li {
      flex: none;
      padding-top: var(--drop-m);
      scroll-snap-align: center;
    }
    .badges :global(.id-card) {
      --w: 190px;
    }
  }
</style>
