---
import { Image } from 'astro:assets';
import { useT, type Lang } from '../../i18n';
import room from '../../assets/photos/room-light.jpg';
import step1 from '../../assets/photos/exam.jpg';
import step2 from '../../assets/photos/xray-review.jpg';
import step3 from '../../assets/photos/treatment-focus.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const stepImages = [step1, step2, step3];
const total = String(t.approach.steps.length).padStart(2, '0');
---

<section class="approach" aria-labelledby="approach-title">
  <div class="expand on-dark" data-expand>
    <div class="expand-frame">
      <Image src={room} alt="" widths={[800, 1200, 1600, 2000, 2400]} sizes="100vw" />
      <div class="expand-shade" aria-hidden="true"></div>
    </div>
    <div class="expand-text container">
      <p class="label label--light">{t.approach.label}</p>
      <h2 id="approach-title" class="h1">{t.approach.statement}</h2>
    </div>
  </div>

  <div class="steps section container" data-steps>
    <div class="grid">
      <div class="steps-media">
        <div class="steps-frame media">
          {stepImages.map((img, i) => (
            <div class={`step-img${i === 0 ? ' is-active' : ''}`} data-step-image>
              <Image src={img} alt="" widths={[600, 900, 1300]} sizes="(max-width: 760px) 100vw, 45vw" />
            </div>
          ))}
        </div>
        <p class="steps-count index-num" aria-hidden="true">
          <span data-step-current>01</span> / {total}
        </p>
      </div>

      <ol class="steps-list">
        {t.approach.steps.map((s, i) => (
          <li class={`step${i === 0 ? ' is-active' : ''}`} data-step>
            <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h2 step-title">{s.title}</h3>
            <p class="lead">{s.text}</p>
            <div class="step-img-mobile media">
              <Image src={stepImages[i]} alt="" widths={[600, 900]} sizes="100vw" />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .approach {
    background: var(--paper);
  }

  /* Expanding image */
  .expand {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: var(--paper);
  }
  .expand-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .expand-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .expand-shade {
    position: absolute;
    inset: 0;
    background: rgb(14 12 12 / 0.42);
  }
  .expand-text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 32px;
    justify-items: center;
    text-align: center;
  }
  .expand-text .h1 {
    max-width: 16em;
    font-weight: 300;
    color: var(--paper);
  }

  /* Sticky steps */
  .steps {
    padding-block: clamp(40px, 4vw, 64px);
  }
  .steps .grid {
    align-items: start;
  }
  .steps-media {
    grid-column: 1 / span 6;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 16px;
  }
  .steps-frame {
    height: min(60vh, 560px);
  }
  .step-img {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.2s var(--ease-in-out);
  }
  .step-img:global(.is-active) {
    clip-path: inset(0 0 0 0);
  }
  .step-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .steps-list {
    grid-column: 8 / span 4;
  }
  .step {
    min-height: min(40vh, 400px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    border-top: 1px solid var(--line);
    opacity: 0.28;
    transition: opacity 0.8s var(--ease);
  }
  .step:global(.is-active) {
    opacity: 1;
  }
  .step-title {
    font-weight: 400;
  }
  .step-img-mobile {
    display: none;
  }

  /* Without motion the steps are a plain readable list */
  :global(html:not(.motion)) .step {
    opacity: 1;
  }

  @media (max-width: 760px) {
    .expand {
      height: 88svh;
    }
    .expand-text {
      justify-items: start;
      text-align: left;
    }
    .expand-text .h1 {
      font-size: clamp(2rem, 8.6vw, 2.5rem);
    }
    .steps-media {
      display: none;
    }
    .steps-list {
      grid-column: 1 / -1;
    }
    .step {
      min-height: 0;
      opacity: 1;
      padding: 40px 0 8px;
      gap: 16px;
    }
    .step-img-mobile {
      display: block;
      aspect-ratio: 4 / 3;
      margin-top: 12px;
    }
  }
</style>
