---
import { Image } from 'astro:assets';
import Arrow from '../Arrow.astro';
import Ph from '../Ph.astro';
import { useT, paths, type Lang } from '../../i18n';
import petritiPhoto from '../../assets/team/Petriti.webp';
import vleraPhoto from '../../assets/team/Vlera.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
// Same order as t.doctors.people
const portraits = [petritiPhoto, vleraPhoto];
---

<section class="doctors section" id="doctors" aria-labelledby="doctors-title">
  <div class="container">
    <header class="head grid">
      <p class="label" data-reveal="fade">{t.doctors.label}</p>
      <h2 id="doctors-title" class="h2" data-split>{t.doctors.heading}</h2>
    </header>

    <div class="team">
      {t.doctors.people.map((d, i) => (
        <article class="doctor">
          <figure class="portrait media" data-reveal="fade">
            <Image
              src={portraits[i]}
              alt={d.name}
              widths={[300, 500, 700]}
              sizes="(max-width: 760px) 60vw, 260px"
            />
          </figure>

          <div class="info">
            <h3 class="name" data-split>{d.name}</h3>
            <Ph as="p" class="role" text={d.role} lang={lang} data-reveal="fade" />
            <Ph as="p" class="body" text={d.bio} lang={lang} data-reveal="fade" />
          </div>
        </article>
      ))}
    </div>

    <div class="more" data-reveal="fade">
      <a class="btn btn--primary" href={paths.team(lang)}>{t.doctors.cta}<Arrow /></a>
    </div>
  </div>
</section>

<style>
  .doctors {
    background: var(--paper);
    /* Follows the Approach steps on the same paper background, whose bottom
       padding already separates the two, so a full section gap reads as empty */
    padding-top: clamp(24px, 2.5vw, 40px);
  }
  .head {
    row-gap: 24px;
    margin-bottom: clamp(40px, 4.5vw, 72px);
  }
  .head .label {
    grid-column: 1 / span 3;
    padding-top: 1.2em;
  }
  .head .h2 {
    grid-column: 4 / span 8;
  }

  /* Centered row of round portraits, each with its details underneath */
  .team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(40px, 5vw, 80px);
  }
  .doctor {
    flex: 0 1 380px;
    display: grid;
    justify-items: center;
    gap: 28px;
    text-align: center;
  }
  .portrait {
    width: clamp(180px, 20vw, 260px);
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--line),
      0 0 0 10px var(--stone);
  }
  .info {
    display: grid;
    gap: 12px;
    justify-items: center;
    width: 100%;
  }
  .name {
    font-size: clamp(1.375rem, 1.8vw, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
  }
  .role {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  .body {
    color: var(--muted);
    max-width: 34ch;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: clamp(40px, 4.5vw, 64px);
  }

  @media (max-width: 1024px) {
    .head .label,
    .head .h2 {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }
  @media (max-width: 760px) {
    .portrait {
      width: min(60vw, 240px);
    }
  }
</style>
