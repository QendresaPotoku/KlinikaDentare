---
// Small set of purposeful icons: contact channels only.
interface Props { name: 'phone' | 'whatsapp' | 'viber' | 'mail' | 'pin'; class?: string }
const { name, class: className = 'icon' } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
  {name === 'phone' && (
    <path d="M5.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 7.2 7.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2Z" />
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4.2 19.8l1.1-3.9A8.4 8.4 0 1 1 8.4 19l-4.2.8Z" />
      <path d="M9.2 8.3c.2-.5.5-.6.8-.6h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a5.6 5.6 0 0 0 2.6 2.3c.2.1.4 0 .5-.1l.6-.7c.2-.2.3-.2.5-.1l1.6.8c.2.1.3.2.3.4 0 .4-.1 1-.6 1.4-.5.4-1.4.7-2.6.3a9 9 0 0 1-4.7-4.2c-.6-1.1-.4-2.2.1-2.8Z" stroke-width="1" />
    </>
  )}
  {name === 'viber' && (
    <>
      <path d="M12 3.2c-4.4 0-7.8 1.2-7.8 6.6 0 3 .9 4.8 2.6 5.8v3.6l2.8-2.7c.8.1 1.6.2 2.4.2 4.4 0 7.8-1.2 7.8-6.6S16.4 3.2 12 3.2Z" />
      <path d="M9.6 7.6c.2-.2.5-.2.7 0l.9 1.2c.1.2.1.4 0 .6l-.4.5a4 4 0 0 0 2.4 2.4l.5-.4c.2-.1.4-.1.6 0l1.2.9c.2.2.2.5 0 .7-.5.6-1.2.9-2 .6a6.4 6.4 0 0 1-4.5-4.5c-.3-.8 0-1.5.6-2Z" stroke-width="1" />
    </>
  )}
  {name === 'mail' && (<><rect x="3.5" y="5.5" width="17" height="13" /><path d="m4 6 8 6.5L20 6" /></>)}
  {name === 'pin' && (<><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>)}
</svg>
