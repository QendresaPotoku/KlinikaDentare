---
import { Image } from 'astro:assets';
import PageHeader from '../PageHeader.astro';
import ClosingCta from '../ClosingCta.astro';
import LogoMark from '../LogoMark.astro';
import Arrow from '../Arrow.astro';
import Ph from '../Ph.astro';
import { useT, paths, type Lang } from '../../i18n';
import { teamGroups, type TeamMember } from '../../data/team';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

// Resolve each member's copy from the dictionaries
function profile(m: TeamMember) {
  if (m.kind === 'doctor') {
    const d = t.doctors.people[m.index];
    const [first, ...rest] = d.name.split(' ');
    return {
      first,
      last: rest.join(' '),
      role: d.role,
      qualification: d.education,
      bio: [d.bio, d.experience],
      cv: t.team.cvPending,
    };
  }
  const s = t.team.staff[m.index];
  return { first: s.name, last: '', role: s.role, qualification: '', bio: [s.bio], cv: [] as string[] };
}
const allMembers = teamGroups.flatMap((g) => g.members);
---

<PageHeader lang={lang} eyebrow={t.team.label} title={t.team.title} />

<section class="team container" aria-label={t.team.title}>
  {teamGroups.map((group) => (
    <div class="row">
      <div class={`group group--${group.id}`} data-reveal="fade">
        <span>{t.team.groups[group.id]}</span>
      </div>
      {group.members.map((m) => {
        const p = profile(m);
        return (
          <button
            type="button"
            class="member"
            data-member={m.id}
            aria-controls="team-drawer"
            aria-haspopup="dialog"
            data-reveal="fade"
          >
            <span class="portrait">
              {m.photo ? (
                <Image src={m.photo} alt="" widths={[240, 480]} sizes="220px" />
              ) : (
                <span class="portrait-ph"><LogoMark /></span>
              )}
            </span>
            <span class="m-name">
              <span class="visually-hidden">{t.team.openProfile} </span>
              <Ph text={p.first} lang={lang} /> {p.last}
            </span>
            <Ph text={p.role} lang={lang} class="m-role" />
          </button>
        );
      })}
    </div>
  ))}
</section>

<ClosingCta lang={lang} />

<div class="backdrop" data-drawer-backdrop hidden></div>
<aside
  class="drawer"
  id="team-drawer"
  role="dialog"
  aria-modal="true"
  aria-label={t.team.title}
  data-drawer
  data-lenis-prevent
  hidden
>
  <button type="button" class="close" data-drawer-close aria-label={t.team.close}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" /></svg>
  </button>

  {allMembers.map((m) => {
    const p = profile(m);
    return (
      <article class="profile" data-profile={m.id} hidden>
        <div class="p-portrait">
          {m.photo ? (
            <Image src={m.photo} alt="" widths={[300, 600]} sizes="240px" />
          ) : (
            <span class="portrait-ph"><LogoMark /></span>
          )}
        </div>
        <Ph as="p" class="p-role" text={p.role} lang={lang} />
        <h2 class="p-name">
          <Ph text={p.first} lang={lang} />
          {p.last && <span class="p-last"> {p.last}</span>}
        </h2>
        {p.qualification && <Ph as="p" class="p-qual" text={p.qualification} lang={lang} />}
        <div class="p-bio">
          {p.bio.map((b) => <Ph as="p" text={b} lang={lang} />)}
        </div>
        {p.cv.length > 0 && (
          <>
            <p class="p-cv-label">{t.team.cvLabel}</p>
            <ul class="p-cv">
              {p.cv.map((c) => <Ph as="li" text={c} lang={lang} />)}
            </ul>
          </>
        )}
        <a class="link link--crimson p-book" href={paths.section(lang, 'contact')} data-book>{t.team.book}<Arrow /></a>
      </article>
    );
  })}
</aside>

<style>
  .team {
    --c: clamp(150px, 14vw, 216px);
    display: grid;
    gap: clamp(40px, 5vw, 72px);
    padding-bottom: var(--section);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(24px, 3vw, 48px);
  }

  /* Group label circles */
  .group {
    width: var(--c);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    text-align: center;
    padding: 16px;
  }
  .group span {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .group--doctors {
    background: var(--crimson);
    color: #fff;
  }
  .group--staff {
    background: var(--ink);
    color: var(--paper);
  }

  /* Member circles */
  .member {
    width: var(--c);
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
    color: var(--ink);
  }
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--stone);
    box-shadow: 0 0 0 0 var(--crimson);
    transition: box-shadow 0.5s var(--ease);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .member:hover .portrait,
  .member:focus-visible .portrait {
    box-shadow: 0 0 0 2px var(--crimson);
  }
  .member:hover .portrait :global(img),
  .member:hover .portrait-ph :global(svg) {
    transform: scale(1.05);
  }
  .member:focus-visible {
    outline: none;
  }
  .portrait-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgb(201 20 60 / 0.35);
  }
  .portrait-ph :global(svg) {
    width: 38%;
    height: auto;
    transition: transform 1s var(--ease);
  }
  .m-name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .member :global(.m-role) {
    margin-top: -8px;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* Drawer */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 140;
    background: rgb(18 16 16 / 0.5);
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .backdrop:global(.is-open) {
    opacity: 1;
  }
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 150;
    width: min(50vw, 760px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--paper);
    transform: translateX(100%);
    transition: transform 0.8s var(--ease-in-out);
  }
  .drawer:global(.is-open) {
    transform: none;
  }
  .close {
    position: sticky;
    top: 0;
    float: right;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    color: var(--ink);
    transition: color 0.4s var(--ease), transform 0.6s var(--ease);
  }
  .close svg {
    width: 26px;
    height: 26px;
  }
  .close:hover {
    color: var(--crimson);
    transform: rotate(90deg);
  }

  .profile {
    padding: clamp(48px, 6vw, 88px) clamp(28px, 6vw, 96px) clamp(56px, 7vw, 96px);
  }
  .p-portrait {
    position: relative;
    width: clamp(160px, 16vw, 240px);
    aspect-ratio: 1;
    margin: 0 auto clamp(40px, 5vw, 64px);
    border-radius: 50%;
    overflow: hidden;
    background: var(--stone);
  }
  .p-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile :global(.p-role) {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .p-name {
    margin-top: 14px;
    font-size: clamp(1.875rem, 2.6vw, 2.625rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .p-last {
    color: var(--crimson);
  }
  .profile :global(.p-qual) {
    margin-top: 12px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .p-bio {
    display: grid;
    gap: 12px;
    margin-top: 28px;
    color: var(--muted);
    max-width: 36em;
  }
  .p-cv-label {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  .p-cv {
    display: grid;
    gap: 10px;
    margin-top: 16px;
    color: var(--ink-soft);
  }
  .p-cv :global(li) {
    position: relative;
    padding-left: 22px;
  }
  .p-cv :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 1px;
    background: var(--crimson);
  }
  .p-book {
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .drawer {
      width: min(88vw, 620px);
    }
  }
  @media (max-width: 600px) {
    .team {
      --c: calc((100vw - 2 * var(--gutter) - 20px) / 2);
    }
    .row {
      gap: 32px 20px;
    }
    .drawer {
      width: 100%;
    }
  }
</style>
