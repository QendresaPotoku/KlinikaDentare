---
// Team page: one editorial row per person, built around their staff badge (the same IdCard as the
// home page). Rows come straight from src/data/team.ts, so adding a member adds a row.
import ClosingCta from '../ClosingCta.astro';
import IdCard, { type IdCardPerson } from '../IdCard.astro';
import Ph from '../Ph.astro';
import { useT, hasPlaceholder, type Lang } from '../../i18n';
import { teamGroups, toneColors } from '../../data/team';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const real = (s: string | undefined): s is string => !!s && !hasPlaceholder(s);

const rows = teamGroups.flatMap((g) =>
  g.members.map((m) => {
    const isDoctor = m.kind === 'doctor';
    const d = isDoctor ? t.doctors.people[m.index] : undefined;
    const s = isDoctor ? undefined : t.team.staff[m.index];
    const name = d?.name ?? s!.name;
    const role = d?.role ?? s!.role;
    const [firstName, ...rest] = name.split(' ');
    const person: IdCardPerson = {
      firstName,
      lastName: rest.join(' '),
      role,
      tone: m.tone,
      photo: m.photo,
      focus: m.focus,
    };
    // The person's own words. Until the clinic sends them, these are [[placeholders]] (highlighted by Ph)
    const statement = (d ? [d.bio, d.experience] : [s!.bio]).filter(Boolean);
    return {
      id: m.id,
      person,
      tag: t.team.groups[g.id],
      quote: d && real(d.quote) ? d.quote : '',
      statement,
      qualification: d?.education ?? '',
      colors: toneColors[m.tone],
    };
  }),
);

// Uneven on purpose, like badges clipped on by hand
const tilts = [-2.5, 2, -1.5, 1.2];
---

<header class="intro container">
  <div class="intro-title">
    <p class="label" data-reveal="fade" data-immediate data-delay="0.2">{t.team.label}</p>
    <h1 class="h1" data-split data-immediate data-delay="0.3">{t.team.title}</h1>
  </div>
</header>

{rows.map((r, i) => (
  <section
    id={r.id}
    class:list={['person', i % 2 ? 'person--even' : 'person--odd']}
    style={`--tone:${r.colors.tone};--tone-soft:${r.colors.soft}`}
    aria-labelledby={`${r.id}-name`}
  >
    <div class="container person-grid">
      <div class="badge-col">
        <IdCard
          person={r.person}
          lang={lang}
          lanyard={false}
          tilt={tilts[i % tilts.length]}
          tag={r.tag}
          eager={i === 0}
          cardSizes="(max-width: 899px) 250px, 320px"
        />
      </div>

      <div class="text-col">
        <Ph as="p" class="role" text={r.person.role} lang={lang} data-reveal="fade" />
        <h2 class="name" id={`${r.id}-name`} data-reveal="fade">
          <span>{r.person.firstName}</span>
          {r.person.lastName && <span>{r.person.lastName}</span>}
        </h2>

        {r.quote && (
          <blockquote class="quote" data-reveal="fade">
            <p>{r.quote}</p>
          </blockquote>
        )}

        {r.qualification && <Ph as="p" class="qualification" text={r.qualification} lang={lang} data-reveal="fade" />}

        {r.statement.length > 0 && (
          <div class="about" data-reveal="fade">
            {r.statement.map((p) => <Ph as="p" text={p} lang={lang} />)}
          </div>
        )}
      </div>
    </div>
  </section>
))}

<ClosingCta lang={lang} />

<style>
  /* ---------- Intro: title and one sentence on a shared baseline ---------- */
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 24px;
    align-items: last baseline;
    padding-top: calc(var(--header-h) + clamp(48px, 6.5vw, 112px));
    padding-bottom: clamp(8px, 1.5vw, 24px);
  }
  .intro-title {
    grid-column: 1 / span 7;
    display: grid;
    gap: 28px;
  }

  /* ---------- One row per person ---------- */
  .person {
    padding-block: clamp(1.25rem, 2.5vw, 2.25rem);
  }
  .person-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .person--even .person-grid {
    grid-template-columns: 6fr 5fr;
  }
  .person--even .badge-col {
    order: 2;
  }

  /* A soft panel behind the badge, with one quarter-circle corner echoing the printed band */
  .badge-col {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 560px;
    padding-block: 2rem;
  }
  .badge-col::before {
    content: '';
    position: absolute;
    inset: 0 8% 0 0;
    border-radius: 0 100% 0 0;
    background: var(--tone-soft);
  }
  .person--odd .badge-col {
    padding-right: 8%;
  }
  .person--even .badge-col {
    padding-left: 8%;
  }
  .person--even .badge-col::before {
    inset: 0 0 0 8%;
    border-radius: 100% 0 0 0;
  }
  .badge-col :global(.id-card) {
    --w: 320px;
  }

  .text-col {
    max-width: 40rem;
    display: grid;
    justify-items: start;
  }
  .text-col :global(.role) {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .name {
    display: grid;
    margin-top: 18px;
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .quote {
    margin-top: clamp(28px, 3vw, 44px);
    padding-left: 1.4rem;
    border-left: 4px solid var(--tone);
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.35rem);
    font-weight: 300;
    line-height: 1.24;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }
  .about {
    display: grid;
    gap: 1.1em;
    margin-top: 28px;
    color: var(--muted);
  }
  .about :global(p) {
    max-width: 60ch;
    text-wrap: pretty;
  }
  .text-col :global(.qualification) {
    margin-top: 24px;
    color: var(--muted);
    max-width: 60ch;
  }

  @media (max-width: 899px) {
    .intro-title {
      grid-column: 1 / -1;
    }
    /* Badge above text in every row; no alternating */
    .person-grid,
    .person--even .person-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .person--even .badge-col {
      order: 0;
    }
    .badge-col,
    .person--odd .badge-col,
    .person--even .badge-col {
      min-height: 0;
      padding: 1.75rem 8% 1.75rem 0;
    }
    .person--even .badge-col::before {
      inset: 0 8% 0 0;
      border-radius: 0 100% 0 0;
    }
    .badge-col :global(.id-card) {
      --w: 250px;
    }
  }
</style>
