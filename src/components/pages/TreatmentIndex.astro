---
import { Image } from 'astro:assets';
import PageHeader from '../PageHeader.astro';
import ClosingCta from '../ClosingCta.astro';
import Arrow from '../Arrow.astro';
import { useT, paths, type Lang } from '../../i18n';
import { treatments } from '../../data/treatments';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<PageHeader
  lang={lang}
  eyebrow={t.nav.treatments}
  title={t.treatmentPage.indexTitle}
  compact
/>

<section class="index container" aria-label={t.treatmentPage.indexTitle}>
  <ul class="cards">
    {treatments.map((tr, i) => {
      const c = tr.copy[lang];
      return (
        <li>
          <a class="card" href={paths.treatment(lang, c.slug)}>
            <figure class="card-img media" data-reveal="mask">
              <div data-parallax="5">
                <Image src={tr.image} alt="" widths={[600, 900, 1300]} sizes="(max-width: 760px) 100vw, 50vw" />
              </div>
            </figure>
            <div class="card-body" data-reveal="fade">
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="card-text">
                <h2 class="card-name">{c.name}</h2>
                <span class="card-sum">{c.summary}</span>
              </span>
              <span class="card-go">
                <span class="visually-hidden">{t.treatments.view}</span>
                <Arrow />
              </span>
            </div>
          </a>
          {tr.children.length > 0 && (
            <div class="subs-wrap" data-reveal="fade">
              <ul class="subs" aria-label={`${t.treatmentPage.options}: ${c.name}`}>
                {tr.children.map((s) => (
                  <li>
                    <a class="sub" href={paths.subTreatment(lang, c.slug, s.copy[lang].slug)}>
                      {s.copy[lang].name}<span class="sub-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      );
    })}
  </ul>
</section>

<ClosingCta lang={lang} />

<style>
  .index {
    padding-top: clamp(8px, 1vw, 16px);
    padding-bottom: var(--section-sm);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 3.5vw, 56px) var(--col-gap);
  }
  /* Each treatment (photo, title row, options) is one unit closed by a single rule */
  .cards > li {
    display: grid;
    align-content: start;
    padding-bottom: clamp(20px, 1.8vw, 28px);
    border-bottom: 1px solid var(--line);
  }
  .card {
    display: grid;
    gap: clamp(18px, 1.6vw, 24px);
  }
  .card-img {
    aspect-ratio: 16 / 10;
  }

  /* Direct links to each sub-treatment, inside the card above the rule */
  .subs-wrap {
    display: grid;
    gap: 10px;
    margin-top: 18px;
    padding-left: calc(40px + 16px);
  }
  .subs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
  }
  .sub {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    font-size: 0.9375rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition:
      color 0.4s var(--ease),
      background-size 0.5s var(--ease);
  }
  .sub-arrow {
    color: var(--crimson);
    transition: transform 0.4s var(--ease);
  }
  .sub:hover,
  .sub:focus-visible {
    color: var(--crimson);
    background-size: 100% 1px;
  }
  .sub:hover .sub-arrow,
  .sub:focus-visible .sub-arrow {
    transform: translateX(4px);
  }
  /* One shared grade so mixed photo sources read as a single set */
  .card-img :global(img) {
    filter: saturate(0.82) sepia(0.08) contrast(1.03);
    transition:
      transform 1.6s var(--ease),
      filter 1s var(--ease);
  }
  .card:hover .card-img :global(img) {
    filter: saturate(0.95) sepia(0.04) contrast(1.03);
  }
  .card:hover .card-img :global(img) {
    transform: scale(1.04);
  }

  /* Number, name + summary, and arrow share one line under the photo */
  .card-body {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: baseline;
    gap: 16px;
  }
  /* Number sits on the title's baseline, arrow centres on the text block */
  .card-go {
    align-self: center;
  }
  .card-text {
    display: grid;
    gap: 6px;
  }
  .card-name {
    font-size: clamp(1.375rem, 2vw, 2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    transition: color 0.5s var(--ease);
  }
  .card-sum {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .card-go {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background-color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      color 0.5s var(--ease);
  }
  .card-go :global(.arrow) {
    width: 18px;
  }
  .card:hover .card-name,
  .card:focus-visible .card-name {
    color: var(--crimson);
  }
  .card:hover .card-go,
  .card:focus-visible .card-go {
    background: var(--crimson);
    border-color: var(--crimson);
    color: #fff;
  }

  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .card-body {
      grid-template-columns: 24px 1fr auto;
      gap: 14px;
    }
    .card-name {
      font-size: 1.3125rem;
    }
    .card-sum {
      font-size: 0.875rem;
    }
    .card-go {
      width: 40px;
      height: 40px;
    }
    .subs-wrap {
      padding-left: calc(24px + 14px);
    }
    .subs {
      gap: 4px 20px;
    }
    .sub {
      font-size: 0.875rem;
    }
  }
</style>
