---
import Ph from './Ph.astro';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n';
import { links } from '../config/site';

interface Props {
  lang: Lang;
  label: string;
  heading: string;
  items: { q: string; a: string }[];
  id?: string;
}
const { lang, label, heading, items, id } = Astro.props;
const t = useT(lang);
---

<section class="faq section" id={id} aria-labelledby={`${id ?? 'faq'}-title`}>
  <div class="container grid">
    <div class="side">
      <p class="label" data-reveal="fade">{label}</p>
      <h2 id={`${id ?? 'faq'}-title`} class="h2" data-split>{heading}</h2>
      <div class="help" data-reveal="fade">
        <p>{t.faq.help}</p>
        <div class="actions">
          <a class="btn btn--ghost" href={links.tel}><Icon name="phone" class="icon ic" />{t.common.call}</a>
          <a class="btn btn--ghost" href={links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" class="icon ic" />WhatsApp</a>
        </div>
      </div>
    </div>
    <div class="accordion" data-reveal="fade">
      {items.map((item) => (
        <details>
          <summary>
            <Ph text={item.q} lang={lang} />
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="answer">
            <Ph as="p" class="answer-inner" text={item.a} lang={lang} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
    padding-block: var(--section-sm);
  }
  .accordion summary {
    padding: 20px 0;
  }
  .accordion :global(.answer-inner) {
    padding-bottom: 24px;
  }
  .side {
    grid-column: 1 / span 4;
    display: grid;
    gap: 28px;
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .accordion {
    grid-column: 6 / span 7;
  }
  .help {
    display: grid;
    gap: 20px;
    margin-top: 12px;
    padding-top: 28px;
    border-top: 1px solid var(--line, rgb(23 23 23 / 0.12));
  }
  .help p {
    color: var(--muted, rgb(23 23 23 / 0.7));
    font-size: var(--fs-lead);
    max-width: 22em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ic {
    width: 19px;
    height: 19px;
  }
  @media (max-width: 900px) {
    .side {
      grid-column: 1 / -1;
      position: static;
      margin-bottom: 40px;
    }
    .accordion {
      grid-column: 1 / -1;
    }
  }
</style>
