---
/** Edit or delete one special day. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ConflictWarning from '../../../components/admin/ConflictWarning.astro';
import SpecialDayFields from '../../../components/admin/SpecialDayFields.astro';
import { getSql } from '../../../server/db/client.ts';
import { deleteDateOverride, saveDateOverride, type PeriodInput } from '../../../server/admin/config.ts';
import { acknowledgedOf, countLabel, emptyState, json, stateFromError, str, versionOf } from '../../../server/admin/forms.ts';
import { formatDateLong, hhmm } from '../../../admin/strings.ts';
import type { OverrideRow } from '../../../server/admin/lists.ts';

export const prerender = false;

const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response(null, { status: 404 });
const sql = getSql();
let state = emptyState();
let posted: { scope: string; kind: 'closed' | 'custom_hours'; date: string; toDate: string; periods: PeriodInput[]; note: string } | null = null;
let deleteConflicts = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = str(form, 'intent');
  try {
    if (intent === 'delete') {
      deleteConflicts = true;
      await deleteDateOverride(sql, id, { acknowledged: acknowledgedOf(form) });
      return Astro.redirect('/admin/special-days/?done=deleted', 303);
    }
    posted = {
      scope: str(form, 'scope'),
      kind: str(form, 'kind') === 'custom_hours' ? 'custom_hours' : 'closed',
      date: str(form, 'date'),
      toDate: '',
      periods: json<PeriodInput[]>(form, 'periods', []),
      note: str(form, 'note'),
    };
    await saveDateOverride(sql, {
      id,
      version: versionOf(form),
      doctorId: posted.scope === 'clinic' ? null : posted.scope,
      date: posted.date,
      kind: posted.kind,
      periods: posted.periods,
      note: posted.note,
    }, { acknowledged: acknowledgedOf(form) });
    return Astro.redirect('/admin/special-days/?done=saved', 303);
  } catch (err) {
    state = stateFromError(err, 'special-day');
    if (state.stale) posted = null;
    Astro.response.status = 409;
  }
}

const [row] = await sql<OverrideRow[]>`
  SELECT o.id, o.date::text AS date, o.doctor_id, d.name AS doctor_name, o.kind, o.note, o.updated_at,
         coalesce(json_agg(json_build_object('startMinute', p.start_minute, 'endMinute', p.end_minute) ORDER BY p.start_minute)
           FILTER (WHERE p.id IS NOT NULL), '[]') AS periods
  FROM date_overrides o LEFT JOIN doctors d ON d.id = o.doctor_id LEFT JOIN date_override_periods p ON p.override_id = o.id
  WHERE o.id = ${id} GROUP BY o.id, d.name`;
if (!row) return Astro.redirect('/admin/special-days/', 303);
const doctors = await sql<{ id: string; name: string }[]>`SELECT id, name FROM doctors WHERE active OR id = ${row.doctorId} ORDER BY sort_order, name`;
const values = posted ?? {
  scope: row.doctorId ?? 'clinic',
  kind: row.kind,
  date: row.date,
  toDate: '',
  periods: row.periods.map((p) => ({ start: hhmm(p.startMinute), end: hhmm(p.endMinute) })),
  note: row.note ?? '',
};
---

<AdminLayout title="Ditë e veçantë" active="special-days">
  <div class="cfg cfg-stack">
    <a class="adm-link cfg-back" href="/admin/special-days/">← Ditë të veçanta</a>
    <h1 class="adm-title first-up">{formatDateLong(row.date)}</h1>
    <p class="muted small">{row.doctorName ?? 'Gjithë klinika'}</p>

    {!deleteConflicts && (
      <form class="adm-panel cfg-form" method="post">
        <input type="hidden" name="intent" value="save" />
        <input type="hidden" name="version" value={row.updatedAt.getTime()} />
        {state.message && <p class={`adm-notice ${state.stale ? 'adm-notice--quiet' : ''}`} role="alert">{state.message}</p>}
        <ConflictWarning conflicts={state.conflicts} title={`Ky ndryshim prek ${countLabel(state.conflicts.length, 'termin ekzistues', 'termine ekzistuese')}.`} />
        <SpecialDayFields doctors={doctors} values={values} fields={state.fields} isNew={false} />
        <div class="cfg-actions"><button class="btn btn--primary btn--sm" type="submit">{state.conflicts.length ? 'Konfirmo dhe ruaj' : 'Ruaj ndryshimet'}</button></div>
      </form>
    )}

    <form class="adm-panel cfg-form" method="post">
      <input type="hidden" name="intent" value="delete" />
      <h2 class="cfg-section-title">Fshi</h2>
      <p class="cfg-help">Data kthehet në orarin e zakonshëm javor.</p>
      {deleteConflicts && state.message && <p class="adm-notice" role="alert">{state.message}</p>}
      {deleteConflicts && (
        <ConflictWarning conflicts={state.conflicts} title={`Pa këtë ditë të veçantë, ${countLabel(state.conflicts.length, 'termin ekzistues bie', 'termine ekzistuese bien')} jashtë orarit.`} />
      )}
      {!deleteConflicts && <label class="adm-check"><input type="checkbox" required /><span>Po, fshije</span></label>}
      <div class="cfg-actions"><button class="btn btn--danger btn--sm" type="submit">{deleteConflicts ? 'Konfirmo dhe fshi' : 'Fshi'}</button></div>
    </form>
  </div>
</AdminLayout>

<style>
  .first-up::first-letter {
    text-transform: uppercase;
  }
</style>
