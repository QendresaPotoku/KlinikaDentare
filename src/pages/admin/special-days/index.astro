---
/** Clinic closures, special opening hours, dentist days off / special hours: list + add form. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ConflictWarning from '../../../components/admin/ConflictWarning.astro';
import SpecialDayFields from '../../../components/admin/SpecialDayFields.astro';
import { getSql } from '../../../server/db/client.ts';
import { saveDateOverride, type PeriodInput } from '../../../server/admin/config.ts';
import { acknowledgedOf, countLabel, emptyState, json, stateFromError, str } from '../../../server/admin/forms.ts';
import { listOverrides, type OverrideRow } from '../../../server/admin/lists.ts';
import { formatDateLong, periodsLabel } from '../../../admin/strings.ts';

export const prerender = false;

const sql = getSql();
const filter = Astro.url.searchParams.get('doctor');
const doctorFilter = filter && /^[0-9a-f-]{36}$/i.test(filter) ? filter : null;
let state = emptyState();
let values = { scope: doctorFilter ?? 'clinic', kind: 'closed' as 'closed' | 'custom_hours', date: '', toDate: '', periods: [] as PeriodInput[], note: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = {
    scope: str(form, 'scope'),
    kind: str(form, 'kind') === 'custom_hours' ? 'custom_hours' : 'closed',
    date: str(form, 'date'),
    toDate: str(form, 'toDate'),
    periods: json<PeriodInput[]>(form, 'periods', []),
    note: str(form, 'note'),
  };
  try {
    await saveDateOverride(sql, {
      doctorId: values.scope === 'clinic' ? null : values.scope,
      date: values.date,
      toDate: values.toDate,
      kind: values.kind,
      periods: values.periods,
      note: values.note,
    }, { acknowledged: acknowledgedOf(form) });
    return Astro.redirect(`/admin/special-days/?done=saved${doctorFilter ? `&doctor=${doctorFilter}` : ''}`, 303);
  } catch (err) {
    state = stateFromError(err, 'special-days');
    Astro.response.status = 409;
  }
}

const doctors = await sql<{ id: string; name: string }[]>`SELECT id, name FROM doctors WHERE active ORDER BY sort_order, name`;
const { upcoming, past } = await listOverrides(sql, { doctorId: doctorFilter, now: Date.now() });
const done = Astro.url.searchParams.get('done');
const describe = (o: OverrideRow) =>
  `${o.doctorName ?? 'Gjithë klinika'} · ${o.kind === 'closed' ? (o.doctorName ? 'Ditë e lirë' : 'E mbyllur') : `Orar i veçantë ${periodsLabel(o.periods)}`}`;
const conflictTitle = `${values.scope === 'clinic' && values.kind === 'closed' ? 'Mbyllja e klinikës prek' : 'Ky ndryshim prek'} ${countLabel(state.conflicts.length, 'termin ekzistues', 'termine ekzistuese')}.`;
---

<AdminLayout title="Ditë të veçanta" active="special-days">
  <div class="cfg cfg-stack">
    <header class="cfg-head">
      <div>
        <h1 class="adm-title">Ditë të veçanta</h1>
        <p class="muted small">Festa dhe mbyllje të klinikës, orare të veçanta për një datë, ose ditë të jashtëzakonshme pune për një dentist.</p>
      </div>
      <form method="get" class="cfg-actions">
        <label class="sr-only" for="f-doctor">Dentisti</label>
        <select id="f-doctor" name="doctor" onchange="this.form.submit()">
          <option value="">Të gjitha</option>
          {doctors.map((d) => <option value={d.id} selected={d.id === doctorFilter}>{d.name} (+ klinika)</option>)}
        </select>
        <noscript><button class="btn btn--ghost btn--sm">Shfaq</button></noscript>
      </form>
    </header>

    {done === 'saved' && <p class="adm-notice adm-notice--ok" role="status">U ruajt.</p>}
    {done === 'deleted' && <p class="adm-notice adm-notice--ok" role="status">U fshi.</p>}

    <section class="cfg-stack">
      <h2 class="cfg-section-title">Të ardhshme</h2>
      {upcoming.length === 0 && <p class="cfg-help">Nuk ka ditë të veçanta të planifikuara.</p>}
      <div class="cfg-list">
        {upcoming.map((o) => (
          <a class="cfg-item" href={`/admin/special-days/${o.id}/`}>
            <div>
              <p class="cfg-item-title first-up">{formatDateLong(o.date)}</p>
              <p class="cfg-item-sub">{describe(o)}{o.note ? ` · ${o.note}` : ''}</p>
            </div>
            <span class={`chip ${o.kind === 'closed' ? 'chip--off' : 'chip--ok'}`}>{o.kind === 'closed' ? 'E mbyllur' : 'Orar i veçantë'}</span>
          </a>
        ))}
      </div>
    </section>

    <form class="adm-panel cfg-form" method="post">
      <h2 class="cfg-section-title">Shto ditë të veçantë</h2>
      {state.message && <p class="adm-notice" role="alert">{state.message}</p>}
      <ConflictWarning conflicts={state.conflicts} title={conflictTitle} />
      <SpecialDayFields doctors={doctors} values={values} fields={state.fields} isNew />
      <div class="cfg-actions">
        <button class="btn btn--primary btn--sm" type="submit">{state.conflicts.length ? 'Konfirmo dhe ruaj' : 'Ruaj'}</button>
      </div>
    </form>

    {past.length > 0 && (
      <details>
        <summary class="adm-link">Të kaluara ({past.length})</summary>
        <div class="cfg-list past">
          {past.slice(0, 50).map((o) => (
            <a class="cfg-item is-off" href={`/admin/special-days/${o.id}/`}>
              <div>
                <p class="cfg-item-title first-up">{formatDateLong(o.date)}</p>
                <p class="cfg-item-sub">{describe(o)}</p>
              </div>
            </a>
          ))}
        </div>
      </details>
    )}
  </div>
</AdminLayout>

<style>
  .first-up::first-letter {
    text-transform: uppercase;
  }
  .past {
    margin-top: 10px;
  }
</style>
